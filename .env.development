# 开发环境配置
# 后端 Mini API 地址（对应 XunFeng.Api.Mini 项目，默认端口 5002）
# 
# ⚠️ 真机调试说明：
# - 浏览器调试：使用 localhost（后端和浏览器在同一台电脑）
# - 手机真机：localhost 指向手机自身，必须改成电脑局域网地址
#   例如：VITE_API_BASE_URL=http://192.168.1.20:5002
#   修改后需要重新运行 npm run dev:app 或 build:app
VITE_API_BASE_URL=https://xf-book-api.kumpoo.cn

# API 统一调度入口（固定路径）
VITE_DISPATCH_URL=/mini/api/dispatch

# ==================== 启动页配置 ====================
# 启动模式：brand（品牌启动）| fast（极速启动）
# brand: 展示品牌 Logo 至少 brandMinDuration 毫秒
# fast:  不展示品牌，快速进入目标页面
VITE_STARTUP_MODE=brand

# 品牌最短展示时长（毫秒），仅 brand 模式有效，默认 2200
VITE_BRAND_MIN_DURATION=2200

# fast 模式下的 Loading 延迟显示阈值（毫秒），默认 180
VITE_FAST_LOADING_DELAY=180
